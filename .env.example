# ==============================================================================
# AI Provider Configuration (Keep API keys out of repository!)
# Provide at least ONE of the following API keys in your .env.local file:
# ==============================================================================

# Option 1 (Recommended - Generous Free Tier & Ultra-fast Whisper large v3):
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option 2 (OpenAI Whisper-1 + GPT-4o-mini):
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Option 3 (Google Gemini 1.5/2.0 Flash Audio):
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
